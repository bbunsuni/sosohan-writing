# PostgreSQL 연결 문자열
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/sosohan?schema=public"

# Auth.js — `npx auth secret` 으로 생성
AUTH_SECRET=""

# 닉네임만으로 로그인하는 개발용 로그인 (OAuth 키 없이 테스트할 때). 운영 환경에서는 절대 켜지 마세요.
AUTH_DEV_LOGIN="true"

# OAuth 제공자
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
AUTH_KAKAO_ID=""
AUTH_KAKAO_SECRET=""
